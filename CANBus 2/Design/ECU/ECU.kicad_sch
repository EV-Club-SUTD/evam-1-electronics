  (text "Termination Resistor (Optional)" (at 118.11 163.83 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 60d9ec2a-348a-4c1c-be0d-8b37835094c8)
  )
  (text "Connectors" (at 67.31 125.73 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 707672e3-c835-42e2-b90a-c82990afc179)
  )
  (text "If I use an optocoupler directly with the 100V input\nThe voltage range of the battery is expected to be 70V-120V,\nany lower and it should ideally cut off (do we want this??)\n\nTypical optocoupler (6N137): V_f=1.4V, I_f=0.01A\nMaximum possible: 120V-1.4V=118.6V, 118.6V/0.01A=11.86kΩ, 118.6V*0.01A=1.186W\nMinimum possible: 70V?\nThus we need a resistor of at least 2W, so we use 2x 24kΩ resistors of 1W each"
    (at 16.51 119.38 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 737d3e58-8b3f-42c8-a2b7-925201bd6954)
  )
  (text "Caution! High Voltage (75-120V) on VBATT!!" (at 17.78 57.785 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid beea9fff-92a6-4211-a909-727f8baa9134)
  )
  (text "Decoupling Capacitors" (at 29.21 21.59 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid fb2a5ea5-a425-4e92-8e45-be8e00c38f73)
  )

